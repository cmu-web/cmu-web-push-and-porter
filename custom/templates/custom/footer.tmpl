{{/* Push & Porter: the CMU template's footer, after Forgejo's own footer line,
     in the template's own markup (footer.grid). The address is
     custom/push-and-porter/address.tmpl. */}}
<div class="push-and-porter-template">
	<footer class="grid column3 invert">
		<div>
			<p>{{template "custom/push-and-porter/address" .}}</p>
			<ul>
				<li><a href="https://www.cmu.edu/legal/">Legal Info</a></li>
				<li><a href="https://www.cmu.edu/">www.cmu.edu</a></li>
			</ul>
			<ul>
				<li>&copy; {{if .PageStartTime}}{{.PageStartTime.Year}} {{end}}Carnegie Mellon University</li>
			</ul>
		</div>
		<div></div>
		<div></div>
	</footer>
</div>
