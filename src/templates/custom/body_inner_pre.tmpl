{{/* Hamerschlag: the CMU template's header, above Forgejo's menu bar, in the
     template's own markup (#container > header) so its stylesheet styles it.
     The theme CSS keeps that stylesheet off the rest of the page. */}}
<div id="container" class="hamerschlag-template">
	<header>
		<div class="roof red invert">
			<div>
				<a class="wordmark" href="https://www.cmu.edu/">Carnegie Mellon University</a>
			</div>
		</div>
		<div id="sitename">
			<span class="sitetitle"><a href="{{AppSubUrl}}/">{{AppName}}</a></span>
		</div>
	</header>
</div>
